# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
APP_URL=http://localhost:3000

# Database and queue values are placeholders until the stack is finalized.
DATABASE_URL=
REDIS_URL=

# Generate a strong random value locally. Do not reuse this example.
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=

# Optional AI provider configuration
AI_PROVIDER=
AI_API_KEY=

# Social provider credentials are added only for integrations being implemented.
# META_APP_ID=
# META_APP_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# Storage: local or s3-compatible, depending on implementation.
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_PATH=./data/media
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
